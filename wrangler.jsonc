{
  // Worker that serves the static site AND a server-side signed-URL redirect at
  // /r/<token>. With run_worker_first left at its default (false), static assets are
  // served directly and the Worker is only invoked for paths that do not match a file
  // (i.e. /r/* and genuine 404s) — so every existing page is unaffected by the Worker.
  "name": "oparli-site",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Non-secret config lives in code so it survives every deploy. NOT secret: the URL,
  // bucket name, and filename reveal nothing without the service key (a private-bucket
  // object is inaccessible without a signed URL). The two SECRETS
  // (REFERENCE_LINK_TOKEN, SUPABASE_SERVICE_ROLE_KEY) are set as encrypted Secrets in
  // the Cloudflare dashboard and are never committed here.
  "vars": {
    "SUPABASE_URL": "https://pohygvyjniougpejfrun.supabase.co",
    "SUPABASE_BUCKET": "ref_letter",
    "REFERENCE_DOC_PATH": "reference-letter.pdf"
  }
}
